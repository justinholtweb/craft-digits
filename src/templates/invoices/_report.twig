{% extends '_layouts/cp' %}

{% set title = 'VAT return'|t('digits') %}
{% set selectedSubnavItem = 'invoices' %}

{% block actionButton %}
    <a class="btn" href="{{ url('digits/invoices/report', { from: from|date('Y-m-d'), to: to|date('Y-m-d'), csv: 1 }) }}">{{ 'Download CSV'|t('digits') }}</a>
{% endblock %}

{% block content %}
    <div class="readable">
        <p>
            {{ 'Sales to customers in other EU countries, by country and rate — the shape the OSS return asks for. {from} to {to}.'|t('digits', { from: from|date('long'), to: to|date('long') }) }}
        </p>
        <p class="light">
            {{ 'Reverse charges and sales outside the scope are excluded from these totals and listed separately below: they belong on the return as a different figure, and leaving them in overstates what is owed.'|t('digits') }}
        </p>
    </div>

    {% if rows is empty %}
        <p class="light">{{ 'Nothing to report in this window.'|t('digits') }}</p>
    {% else %}
        <table class="data fullwidth" style="margin-top: 18px;">
            <thead>
                <tr>
                    <th>{{ 'Country'|t('digits') }}</th>
                    <th>{{ 'Rate'|t('digits') }}</th>
                    <th class="rightalign">{{ 'Invoices'|t('digits') }}</th>
                    <th class="rightalign">{{ 'Net'|t('digits') }}</th>
                    <th class="rightalign">{{ 'VAT due'|t('digits') }}</th>
                </tr>
            </thead>
            <tbody>
                {% for row in rows %}
                    <tr>
                        <td>{{ row.countryName }} <span class="light code">{{ row.buyerCountry }}</span></td>
                        <td>{{ row.vatRate }}%</td>
                        <td class="rightalign">{{ row.invoices }}</td>
                        <td class="rightalign">{{ row.net|number_format(2) }}</td>
                        <td class="rightalign">{{ row.vat|number_format(2) }} <span class="light">{{ row.currency }}</span></td>
                    </tr>
                {% endfor %}
            </tbody>
            <tfoot>
                <tr>
                    <th colspan="3">{{ 'Total'|t('digits') }}</th>
                    <th class="rightalign">{{ net|number_format(2) }}</th>
                    <th class="rightalign">{{ vat|number_format(2) }}</th>
                </tr>
            </tfoot>
        </table>
    {% endif %}

    <hr>

    <h2>{{ 'Everything else in the window'|t('digits') }}</h2>

    <table class="data fullwidth">
        <thead>
            <tr>
                <th>{{ 'Treatment'|t('digits') }}</th>
                <th class="rightalign">{{ 'Invoices'|t('digits') }}</th>
                <th class="rightalign">{{ 'Net'|t('digits') }}</th>
                <th class="rightalign">{{ 'VAT'|t('digits') }}</th>
            </tr>
        </thead>
        <tbody>
            {% for row in totals %}
                <tr>
                    <td>{{ row.treatment }}</td>
                    <td class="rightalign">{{ row.invoices }}</td>
                    <td class="rightalign">{{ row.net|number_format(2) }}</td>
                    <td class="rightalign">{{ row.vat|number_format(2) }} <span class="light">{{ row.currency }}</span></td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}
